{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://continuum.local/schemas/implementation-work-package.schema.json",
  "title": "Continuum Implementation Work Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "phase",
    "title",
    "status",
    "risk",
    "approval_required",
    "source_requirements",
    "dependencies",
    "acceptance_gates",
    "blockers",
    "rollback"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Z0-9-]+$"},
    "phase": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["planned", "ready", "in_progress", "blocked", "complete"]
    },
    "risk": {"enum": ["low", "medium", "high", "critical"]},
    "approval_required": {"type": "boolean"},
    "source_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "acceptance_gates": {
      "type": "array",
      "items": {"$ref": "#/$defs/gate"}
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "rollback": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "hard", "status", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "hard": {"type": "boolean"},
        "status": {"enum": ["PENDING", "PASS", "FAIL", "WAIVED"]},
        "evidence": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["path"],
                "properties": {"path": {"type": "string", "minLength": 1}}
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["external_ref"],
                "properties": {"external_ref": {"type": "string", "minLength": 1}}
              }
            ]
          }
        }
      }
    }
  }
}
